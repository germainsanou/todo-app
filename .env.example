# ---------- Django ----------
# Générer une clé (une par environnement, à ne jamais commiter) :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Uniquement lettres, chiffres, - et _ : pas de $ ni de # qui seraient
# interprétés par Docker Compose ou pris pour un commentaire.
DJANGO_SECRET_KEY=a-remplacer
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Sécurité HTTPS (voir backend/config/settings/production.py)
# Mettre False uniquement pour tester l'image Docker en HTTP sur sa machine
DJANGO_SECURE_COOKIES=False
# En production, une fois le HTTPS en place : 31536000 (1 an)
DJANGO_SECURE_HSTS_SECONDS=0

# ---------- Emails (vérification d'adresse, mot de passe oublié) ----------
DJANGO_DEFAULT_FROM_EMAIL=Mon projet <noreply@exemple.com>
# En local : MailDev (service « smtp » de compose.yaml), emails visibles sur http://localhost:1080
# En production : le serveur SMTP du projet (ex. port 587, TLS True, identifiants)
DJANGO_EMAIL_HOST=smtp
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_HOST_USER=support@exemple.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=False

# ---------- PostgreSQL ----------
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=a-remplacer

# Connexion de Django à PostgreSQL (« db » = nom du service dans compose.yaml)
DATABASE_URL=postgres://todo:a-remplacer@db:5432/todo
